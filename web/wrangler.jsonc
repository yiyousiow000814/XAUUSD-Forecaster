{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aurum-signal-room",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "secrets": {
    "required": [
      "INGEST_TOKEN"
    ]
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aurum-signal-room",
      "database_id": "3ef51a58-bb3b-4443-b527-be3af4d5c6b2",
      "migrations_dir": "drizzle"
    }
  ],
  "vectorize": [
    {
      "binding": "ASSISTANT_MEMORY_VECTOR",
      "index_name": "aurum-assistant-memory"
    }
  ],
  "images": {
    "binding": "IMAGES"
  }
}
