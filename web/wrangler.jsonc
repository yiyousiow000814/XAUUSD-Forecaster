{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aurum-signal-room",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*", "/admin/api/*", "/_vinext/image", "/status",
      "/assistant", "/retry-jobs"
    ]
  },
  "secrets": {
    "required": [
      "INGEST_TOKEN"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aurum-signal-room",
      "database_id": "3ef51a58-bb3b-4443-b527-be3af4d5c6b2",
      "migrations_dir": "drizzle"
    }
  ],
  "vectorize": [
    {
      "binding": "ASSISTANT_MEMORY_VECTOR",
      "index_name": "aurum-assistant-memory"
    }
  ],
  "images": {
    "binding": "IMAGES"
  }
}
