{
  "name": "site-creator-vinext-starter",
  "version": "0.1.1",
  "private": true,
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run cf:types:check && npm run build && node --import ./tests/register-cloudflare-worker-loader.mjs --test tests/rendered-html.test.mjs tests/responsive-scroll.test.mjs tests/market-open-window.test.mjs tests/news-retrieval.test.mjs tests/assistant-auth.test.mjs tests/assistant-conversations.test.mjs tests/assistant-events.test.mjs tests/assistant-memory.test.mjs tests/assistant-routing.test.mjs tests/assistant-content.test.mjs tests/assistant-evidence.test.mjs tests/assistant-chat.test.mjs tests/assistant-chat-client.test.mjs tests/news-questions.test.mjs tests/news-questions-route.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "cf:types": "wrangler types worker-configuration.d.ts",
    "cf:types:check": "wrangler types worker-configuration.d.ts --check",
    "cf:deploy": "npm run test && wrangler deploy"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "jose": "6.2.9",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.52.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.6",
    "vite": "8.2.1",
    "wrangler": "4.123.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "type": "module"
}
