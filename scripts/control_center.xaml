<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XAUUSD Forecaster Control Center" Width="1120" Height="760"
        MinWidth="720" MinHeight="500" Background="#F2F3EF"
        FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="16,7"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#CBD1CD"/></Style>
    <Style TargetType="Border" x:Key="Card"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#D5D9D5"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="18"/></Style>
    <Style TargetType="TextBlock" x:Key="Eyebrow"><Setter Property="Foreground" Value="#687370"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  </Window.Resources>
  <ScrollViewer x:Name="RootScrollViewer" VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
  <Grid x:Name="RootLayout" Margin="26" MinWidth="650">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#203B39" Padding="24,20" CornerRadius="3">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="XAUUSD FORECASTER" Foreground="White" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="LOCAL CONTROL CENTER  /  FORWARD-ONLY OPERATIONS" Foreground="#BFD8D1" FontSize="11" Margin="0,6,0,0"/><TextBlock x:Name="ControlPlaneIdentity" Text="Control Plane  --  UNVERIFIED" Foreground="White" FontFamily="Consolas" FontSize="11" Margin="0,8,0,0"/><TextBlock x:Name="BusinessRuntimeIdentity" Text="Business Runtime  --" Foreground="#BFD8D1" FontFamily="Consolas" FontSize="11" Margin="0,2,0,0"/></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="LOCAL RUNTIME  " Foreground="#BFD8D1"/><TextBlock x:Name="OverallState" Text="CHECKING" Foreground="White" FontWeight="Bold"/><TextBlock Text="     LAST REFRESH  " Foreground="#BFD8D1"/><TextBlock x:Name="RefreshTime" Text="--" Foreground="White"/></StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,14">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="LOCAL SERVICES" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="Owners on this Windows host" Style="{StaticResource Eyebrow}" Margin="0,4,0,0"/></StackPanel>
        <ItemsControl x:Name="ServiceList" Grid.Column="1" Margin="10,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding State}" FontWeight="SemiBold" Foreground="#197565" VerticalAlignment="Center"/><StackPanel Grid.Column="2" Orientation="Horizontal"><Button Content="Start" Tag="{Binding Key}" CommandParameter="ServiceStart" MinHeight="30" Padding="10,3"/><Button Content="Stop" Tag="{Binding Key}" CommandParameter="ServiceStop" MinHeight="30" Padding="10,3"/></StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <Button x:Name="RefreshButton" Grid.Column="2" Content="Refresh status" VerticalAlignment="Top"/>
      </Grid>
    </Border>
    <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel Margin="2,0,0,8"><TextBlock Text="RELEASE CONTROL" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="One exact Git / Worker / Windows release at every boundary" Style="{StaticResource Eyebrow}"/></StackPanel>
      <Grid x:Name="ReleaseGrid" Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.45*"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>
        <Border x:Name="StableCard" Style="{StaticResource Card}" Margin="0,0,8,0" MinHeight="360"><StackPanel><TextBlock Text="STABLE" FontWeight="SemiBold" FontSize="18"/><TextBlock x:Name="StableState" Text="UNAVAILABLE" Margin="0,10"/><TextBlock x:Name="StableIdentity" Text="Git       --&#10;Worker    --&#10;Windows   --" FontFamily="Consolas" LineHeight="24"/><TextBlock Text="Production traffic owner" Style="{StaticResource Eyebrow}" Margin="0,18,0,12"/><Button x:Name="OpenStableButton" Content="Open Stable" HorizontalAlignment="Left"/></StackPanel></Border>
        <Border x:Name="CandidateCard" Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,8,0" MinHeight="420" BorderBrush="#208170" BorderThickness="1,4,1,1"><StackPanel><TextBlock Text="RELEASE CANDIDATE" FontWeight="SemiBold" FontSize="18"/><TextBlock x:Name="CandidateState" Text="UNAVAILABLE" Margin="0,10" FontWeight="Bold"/><TextBlock x:Name="CandidateIdentity" Text="Git       --&#10;Worker    --&#10;Windows   --" FontFamily="Consolas" LineHeight="24"/><TextBlock x:Name="CandidateChecks" Text="Repository: unavailable&#10;Windows preflight: unavailable&#10;API routes: unavailable&#10;Data parity: unavailable&#10;CPU headroom: unavailable&#10;5xx / 1102: unavailable&#10;Compatibility: unavailable&#10;Access boundary: formal-host only" Style="{StaticResource Eyebrow}" LineHeight="18" Margin="0,12,0,0"/><Border Background="#F2F3EF" Padding="10" Margin="0,12,0,12"><TextBlock x:Name="CandidateReason" Text="Cannot promote: Candidate validation is unavailable." TextWrapping="Wrap"/></Border><WrapPanel x:Name="CandidateActionPanel"><Button x:Name="OpenCandidateButton" Content="Open Candidate" IsEnabled="False"/><Button x:Name="VerifyMigrationButton" Content="Verify Migration" IsEnabled="False"/><Button x:Name="ApproveCompatibilityButton" Content="Approve Compatibility" IsEnabled="False"/><Button x:Name="ApproveAccessButton" Content="Approve Access Checks" IsEnabled="False"/><Button x:Name="PromoteButton" Content="Promote Candidate" IsEnabled="False"/></WrapPanel><Expander x:Name="CandidateEvidenceExpander" Header="Technical evidence" Margin="0,12,0,0"><TextBox x:Name="CandidateTechnicalEvidence" Text="No exact-version evidence loaded." TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" IsReadOnly="True" BorderThickness="0" Background="Transparent"/></Expander></StackPanel></Border>
        <Border x:Name="PreviousCard" Grid.Column="2" Style="{StaticResource Card}" MinHeight="360"><StackPanel><TextBlock Text="PREVIOUS STABLE" FontWeight="SemiBold" FontSize="18"/><TextBlock x:Name="PreviousState" Text="UNAVAILABLE" Margin="0,10"/><TextBlock x:Name="PreviousIdentity" Text="Git       --&#10;Worker    --&#10;Windows   --" FontFamily="Consolas" LineHeight="24"/><TextBlock Text="Explicit rollback identity" Style="{StaticResource Eyebrow}" Margin="0,18,0,16"/><Button x:Name="ReverseButton" Content="Reverse Stable" IsEnabled="False" HorizontalAlignment="Left" BorderBrush="#B43A31" Foreground="#B43A31"/></StackPanel></Border>
      </Grid>
    </Grid>
    <Border Grid.Row="3" Background="#E9E8E1" Padding="14" Margin="0,14,0,0"><StackPanel><WrapPanel><Button x:Name="StartButton" Content="Start All" Background="#203B39" Foreground="White"/><Button x:Name="RestartButton" Content="Restart All"/><Button x:Name="StopButton" Content="Stop All" BorderBrush="#B43A31" Foreground="#B43A31"/><Button x:Name="DashboardButton" Content="Open Dashboard"/><Button x:Name="LogsButton" Content="Open Logs"/></WrapPanel><TextBlock x:Name="FooterDisclaimer" HorizontalAlignment="Right" Foreground="#687370" Margin="0,10,0,0" Text="Decision support only · never authorizes trading"/></StackPanel></Border>
  </Grid>
  </ScrollViewer>
</Window>
