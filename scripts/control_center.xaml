<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XAUUSD Forecaster Control Center" Width="1120" Height="790"
        MinWidth="920" MinHeight="680" Background="#F2F3EF"
        FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="16,7"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#CBD1CD"/></Style>
    <Style TargetType="Border" x:Key="Card"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#D5D9D5"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="18"/></Style>
    <Style TargetType="TextBlock" x:Key="Eyebrow"><Setter Property="Foreground" Value="#687370"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  </Window.Resources>
  <Grid Margin="26">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#203B39" Padding="24,20" CornerRadius="3">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="XAUUSD FORECASTER" Foreground="White" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="LOCAL CONTROL CENTER  /  FORWARD-ONLY OPERATIONS" Foreground="#BFD8D1" FontSize="11" Margin="0,6,0,0"/></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="OVERALL  " Foreground="#BFD8D1"/><TextBlock x:Name="OverallState" Text="CHECKING" Foreground="White" FontWeight="Bold"/><TextBlock Text="     LAST REFRESH  " Foreground="#BFD8D1"/><TextBlock x:Name="RefreshTime" Text="--" Foreground="White"/></StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,14">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="LOCAL SERVICES" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="Owners on this Windows host" Style="{StaticResource Eyebrow}" Margin="0,4,0,0"/></StackPanel>
        <ItemsControl x:Name="ServiceList" Grid.Column="1" Margin="10,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}"/><TextBlock Grid.Column="1" Text="{Binding State}" FontWeight="SemiBold" Foreground="#197565"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <Button x:Name="RefreshButton" Grid.Column="2" Content="Refresh status" VerticalAlignment="Top"/>
      </Grid>
    </Border>
    <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel Margin="2,0,0,8"><TextBlock Text="RELEASE CONTROL" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="One exact Git / Worker / Windows release at every boundary" Style="{StaticResource Eyebrow}"/></StackPanel>
      <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="STABLE" FontWeight="SemiBold" FontSize="18"/><TextBlock x:Name="StableState" Text="UNAVAILABLE" Margin="0,10"/><TextBlock x:Name="StableIdentity" Text="Git       --&#10;Worker    --&#10;Windows   --" FontFamily="Cascadia Mono" LineHeight="24"/><TextBlock Text="Production traffic owner" Style="{StaticResource Eyebrow}" Margin="0,18,0,0"/></StackPanel></Border>
        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,8,0" BorderBrush="#208170" BorderThickness="1,4,1,1"><StackPanel><TextBlock Text="RELEASE CANDIDATE" FontWeight="SemiBold" FontSize="18"/><TextBlock x:Name="CandidateState" Text="UNAVAILABLE" Margin="0,10"/><TextBlock x:Name="CandidateIdentity" Text="Git       --&#10;Worker    --&#10;Windows   --" FontFamily="Cascadia Mono" LineHeight="24"/><TextBlock x:Name="CandidateReason" Text="Candidate validation is unavailable." TextWrapping="Wrap" Margin="0,18,0,16"/><Button x:Name="PromoteButton" Content="Promote Candidate" IsEnabled="False" HorizontalAlignment="Left"/></StackPanel></Border>
        <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="PREVIOUS STABLE" FontWeight="SemiBold" FontSize="18"/><TextBlock x:Name="PreviousState" Text="UNAVAILABLE" Margin="0,10"/><TextBlock x:Name="PreviousIdentity" Text="Git       --&#10;Worker    --&#10;Windows   --" FontFamily="Cascadia Mono" LineHeight="24"/><TextBlock Text="Explicit rollback identity" Style="{StaticResource Eyebrow}" Margin="0,18,0,16"/><Button x:Name="ReverseButton" Content="Reverse Stable" IsEnabled="False" HorizontalAlignment="Left" BorderBrush="#B43A31" Foreground="#B43A31"/></StackPanel></Border>
      </Grid>
    </Grid>
    <Border Grid.Row="3" Background="#E9E8E1" Padding="14" Margin="0,14,0,0"><Grid><StackPanel Orientation="Horizontal"><Button x:Name="StartButton" Content="Start All" Background="#203B39" Foreground="White"/><Button x:Name="RestartButton" Content="Restart All"/><Button x:Name="StopButton" Content="Stop All" BorderBrush="#B43A31" Foreground="#B43A31"/><Button x:Name="DashboardButton" Content="Open Dashboard"/><Button x:Name="LogsButton" Content="Open Logs"/></StackPanel><TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#687370" Text="Decision support only · never authorizes trading"/></Grid></Border>
  </Grid>
</Window>
