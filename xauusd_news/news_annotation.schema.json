{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xauusd.forward.news-annotation.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "headline_zh", "summary_zh", "primary_category", "secondary_categories",
    "emerging_topic_zh", "record_kind", "actor", "action", "object",
    "location", "event_time", "claim_status", "materiality",
    "canonical_actor_id", "action_family", "canonical_object_id",
    "canonical_location_id", "episode_key", "primary_story_title_zh",
    "secondary_contexts_zh", "relation_to_prior", "document_kind",
    "material_event_key", "source_organization_id", "evidence_role",
    "event_type", "entities", "hawkishness", "inflation_impulse",
    "growth_impulse", "geopolitical_risk", "usd_impulse", "novelty",
    "confidence"
  ],
  "properties": {
    "headline_zh": {
      "type": "string", "minLength": 2, "maxLength": 300,
      "description": "Faithful Simplified Chinese translation of the source headline"
    },
    "summary_zh": {
      "type": "string", "minLength": 20, "maxLength": 1600,
      "description": "Simplified Chinese summary of the complete source content"
    },
    "primary_category": {
      "type": "string",
      "enum": [
        "rates_fed", "inflation_employment", "growth_economy",
        "usd_liquidity", "oil_energy", "war_geopolitics",
        "central_bank_gold", "risk_sentiment", "regulation_other"
      ],
      "description": "Best matching controlled XAUUSD news domain"
    },
    "secondary_categories": {
      "type": "array", "maxItems": 2,
      "items": {
        "type": "string",
        "enum": [
          "rates_fed", "inflation_employment", "growth_economy",
          "usd_liquidity", "oil_energy", "war_geopolitics",
          "central_bank_gold", "risk_sentiment", "regulation_other"
        ]
      },
      "uniqueItems": true,
      "description": "At most two additional controlled domains"
    },
    "emerging_topic_zh": {
      "type": "string", "maxLength": 16,
      "description": "One concise Simplified Chinese subtopic; never creates a new top-level domain"
    },
    "record_kind": {"type": "string", "enum": ["FACT_EVENT", "OFFICIAL_CLAIM", "MARKET_REACTION", "COMMENTARY_FORECAST", "BACKGROUND"]},
    "actor": {"type": "string", "maxLength": 160},
    "action": {"type": "string", "maxLength": 160},
    "object": {"type": "string", "maxLength": 160},
    "location": {"type": "string", "maxLength": 160},
    "event_time": {"type": "string", "maxLength": 64, "description": "ISO-like event time from the source, or an empty string when unknown"},
    "claim_status": {"type": "string", "enum": ["REPORTED", "OFFICIAL", "CONFIRMED", "DISPUTED", "DENIED", "CORRECTED", "NOT_APPLICABLE"]},
    "materiality": {"type": "number", "minimum": 0, "maximum": 1},
    "canonical_actor_id": {"type": "string", "maxLength": 96},
    "action_family": {"type": "string", "enum": ["POLICY_DECISION", "OFFICIAL_STATEMENT", "THREAT", "MILITARY_ACTION", "SHIPPING_DISRUPTION", "SANCTION", "ECONOMIC_RELEASE", "GOLD_PURCHASE", "ENERGY_SUPPLY_CHANGE", "REGULATORY_ACTION", "OTHER_FACT"]},
    "canonical_object_id": {"type": "string", "maxLength": 96},
    "canonical_location_id": {"type": "string", "maxLength": 96},
    "episode_key": {"type": "string", "maxLength": 120, "description": "One stable snake_case event episode key; empty when this record cannot be assigned safely"},
    "primary_story_title_zh": {"type": "string", "maxLength": 100},
    "secondary_contexts_zh": {"type": "array", "maxItems": 2, "items": {"type": "string", "minLength": 2, "maxLength": 30}, "uniqueItems": true},
    "relation_to_prior": {"type": "string", "enum": ["NONE", "CONFIRMS", "CONTRADICTS", "RESPONDS_TO", "ESCALATES", "DEESCALATES", "SUPERSEDES", "MARKET_REACTS_TO", "FOLLOWED_BY"]},
    "document_kind": {"type": "string", "enum": ["OFFICIAL_STATEMENT", "PRESS_CONFERENCE", "MEETING_MINUTES", "REPORT", "NEWS_REPORT", "MARKET_REPORT", "ANALYSIS", "BACKGROUND"]},
    "material_event_key": {"type": "string", "maxLength": 160},
    "source_organization_id": {"type": "string", "maxLength": 120},
    "evidence_role": {"type": "string", "enum": ["CORE_CLAIM", "EVIDENCE_DOCUMENT", "MARKET_REACTION", "COMMENTARY", "BACKGROUND"]},
    "event_type": {"type": "string", "minLength": 1},
    "entities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "hawkishness": {"type": "number", "minimum": -1, "maximum": 1},
    "inflation_impulse": {"type": "number", "minimum": -1, "maximum": 1},
    "growth_impulse": {"type": "number", "minimum": -1, "maximum": 1},
    "geopolitical_risk": {"type": "number", "minimum": -1, "maximum": 1},
    "usd_impulse": {"type": "number", "minimum": -1, "maximum": 1},
    "novelty": {"type": "number", "minimum": 0, "maximum": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
