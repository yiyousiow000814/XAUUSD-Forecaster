{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xauusd.forward.news-annotation.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "headline_zh",
    "summary_zh",
    "primary_category",
    "secondary_categories",
    "emerging_topic_zh",
    "event_type",
    "entities",
    "hawkishness",
    "inflation_impulse",
    "growth_impulse",
    "geopolitical_risk",
    "usd_impulse",
    "novelty",
    "confidence"
  ],
  "properties": {
    "headline_zh": {
      "type": "string",
      "minLength": 2,
      "maxLength": 300,
      "description": "Faithful Simplified Chinese translation of the source headline"
    },
    "summary_zh": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1600,
      "description": "Simplified Chinese summary of the complete source content"
    },
    "primary_category": {
      "type": "string",
      "enum": [
        "rates_fed",
        "inflation_employment",
        "growth_economy",
        "usd_liquidity",
        "oil_energy",
        "war_geopolitics",
        "central_bank_gold",
        "risk_sentiment",
        "regulation_other"
      ],
      "description": "Best matching controlled XAUUSD news domain"
    },
    "secondary_categories": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "string",
        "enum": [
          "rates_fed",
          "inflation_employment",
          "growth_economy",
          "usd_liquidity",
          "oil_energy",
          "war_geopolitics",
          "central_bank_gold",
          "risk_sentiment",
          "regulation_other"
        ]
      },
      "uniqueItems": true,
      "description": "At most two additional controlled domains"
    },
    "emerging_topic_zh": {
      "type": "string",
      "maxLength": 16,
      "description": "One concise Simplified Chinese subtopic; never creates a new top-level domain"
    },
    "event_type": {"type": "string", "minLength": 1},
    "entities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "hawkishness": {"type": "number", "minimum": -1, "maximum": 1},
    "inflation_impulse": {"type": "number", "minimum": -1, "maximum": 1},
    "growth_impulse": {"type": "number", "minimum": -1, "maximum": 1},
    "geopolitical_risk": {"type": "number", "minimum": -1, "maximum": 1},
    "usd_impulse": {"type": "number", "minimum": -1, "maximum": 1},
    "novelty": {"type": "number", "minimum": 0, "maximum": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
