{
  "version": 1,
  "shared_paths": [
    "formal/tools/tlc/*",
    ".github/workflows/formal-verification.yml",
    "scripts/run_tla_model.py",
    "scripts/select_tla_shards.py",
    "formal/release-control/shards.json",
    "formal/release-control/README.md",
    "formal/release-control/DECOMPOSITION_AUDIT.md",
    "docs/contracts/RELEASE_CONTROL.md",
    "docs/protocols/CHANGE_SAFETY.md",
    "AGENTS.md"
  ],
  "shards": [
    {
      "id": "cpu-evidence-safety",
      "module": "CpuEvidence.tla",
      "config": "CpuEvidenceSafety.cfg",
      "kind": "safety",
      "paths": [
        "scripts/worker_cpu_evidence.ps1",
        "formal/release-control/CpuEvidence*"
      ],
      "properties": [
        "TypeOK",
        "CpuQualificationIsValid",
        "CpuRetryBudgetIsBounded",
        "DeficitRepairRequestBudgetIsBounded",
        "DeficitRepairSetIsFrozen",
        "QualifiedFamiliesAreNeverReplayed",
        "DeficitRepairCannotFabricateEvidence",
        "NoSecondDeficitRepairRound",
        "ReserveEvidenceUseIsBounded",
        "CpuHardFailureCannotQualify",
        "OutlierRequiresBoundedConfirmation",
        "NoSecondOutlierConfirmation",
        "OutlierConfirmationMatchesRequestShape",
        "RepeatedCpuPressureCannotQualify",
        "OriginalOutlierCannotBeErased",
        "ReusedCpuEvidenceMatchesArtifact",
        "CpuRecoveryPreservesIndependentStages",
        "EveryRequiredFamilyQuotaSatisfied",
        "ArtifactKeyChangeInvalidatesReuse",
        "CpuEvidenceOnlyGrows",
        "TargetedRetryPreservesAcceptedWork"
      ]
    },
    {
      "id": "cpu-evidence-liveness",
      "module": "CpuEvidence.tla",
      "config": "CpuEvidenceLiveness.cfg",
      "kind": "liveness",
      "paths": [
        "scripts/worker_cpu_evidence.ps1",
        "formal/release-control/CpuEvidence*"
      ],
      "properties": [
        "TypeOK",
        "CpuQualificationIsValid",
        "CpuRetryBudgetIsBounded",
        "DeficitRepairRequestBudgetIsBounded",
        "DeficitRepairSetIsFrozen",
        "QualifiedFamiliesAreNeverReplayed",
        "DeficitRepairCannotFabricateEvidence",
        "NoSecondDeficitRepairRound",
        "ReserveEvidenceUseIsBounded",
        "CpuHardFailureCannotQualify",
        "OutlierRequiresBoundedConfirmation",
        "NoSecondOutlierConfirmation",
        "OutlierConfirmationMatchesRequestShape",
        "RepeatedCpuPressureCannotQualify",
        "OriginalOutlierCannotBeErased",
        "PendingEventuallyResolves"
      ]
    },
    {
      "id": "news-migration-safety",
      "module": "NewsMigration.tla",
      "config": "NewsMigrationSafety.cfg",
      "kind": "safety",
      "paths": [
        "scripts/build_news_projection_generation.py",
        "formal/release-control/NewsMigration*"
      ],
      "properties": [
        "TypeOK",
        "VerificationWatermarkDoesNotRegress",
        "ActiveLegacyEqualsCurrent",
        "LegacyStableWritesRemainFenced",
        "CurrentIdentitySetMatchesGeneration",
        "FreshStagingIdentitySetMatchesGeneration",
        "CurrentGenerationCannotBeCleaned",
        "FreshStagingCannotBeCleaned",
        "InvalidStagedLegacyCannotActivate"
      ]
    },
    {
      "id": "access-evidence-safety",
      "module": "AccessEvidence.tla",
      "config": "AccessEvidenceSafety.cfg",
      "kind": "safety",
      "paths": [
        "scripts/access-qualification-contract.json",
        "formal/release-control/AccessEvidence*"
      ],
      "properties": [
        "TypeOK",
        "AccessEvidenceIsRequired",
        "InvalidAccessReceiptCannotPass",
        "AccessApprovalIsIdempotent",
        "ReuseRequiresExactAccessKey",
        "UnreadableOrChangedProviderCannotReuse",
        "AccessFailureCannotReuse",
        "ReuseDoesNotFabricateHumanApproval",
        "RenewalRequiresContinuousAudit",
        "StaleMachineEvidenceCannotPass",
        "BrokenChainCannotRenew",
        "RenewalKeepsHumanRoot",
        "RenewalIsBounded"
      ]
    }
  ]
}
