          "path": "tests/dashboard/test_public_health_check.py"
        },
        {
          "path": "tests/runtime/test_runtime_health.py"
        },
        {
          "path": "tests/runtime/test_runtime_root_ownership.py"
        },
        {
          "path": "tests/runtime/test_cross_version_runtime_recovery.py"
        }
      ]
    },
    {
      "id": "news-discovery-admission",
      "family": "news-discovery-admission",
      "paths": [
        "tests/news/test_news_scheduler.py",
