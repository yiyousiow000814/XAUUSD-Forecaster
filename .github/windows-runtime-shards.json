        "xauusd_forecaster/news/annotation/*",
        "xauusd_forecaster/news/semantics/critical_state.py"
      ],
      "tests": [
        {
          "path": "tests/news/test_news_scheduler.py",
          "from": "test_live_annotation_claim_preempts_aged_contract_backfill",
          "through": "test_annotation_surge_takes_priority_after_embedding_pressure_falls"
        }
      ]
    },
    {
      "id": "news-recovery-accounts",
      "family": "news-recovery-accounts",
      "paths": [
        "tests/news/test_news_scheduler.py",
        "xauusd_forecaster/news/scheduler/*",
        "xauusd_forecaster/news/annotation/*",
        "xauusd_forecaster/news/semantics/critical_state.py"
      ],
      "tests": [
        {
          "path": "tests/news/test_news_scheduler.py",
          "from": "test_identity_contract_recovery_requeues_each_impact_only_once",
          "through": "test_runtime_credentials_hot_reload_user_configuration"
        }
      ]
    },
    {
      "id": "news-queue-execution",
      "family": "news-queue-execution",
      "paths": [
        "tests/news/test_news_scheduler.py",
        "xauusd_forecaster/news/scheduler/*",
        "xauusd_forecaster/news/annotation/*",
        "xauusd_forecaster/news/semantics/critical_state.py"
      ],
      "tests": [
        {
          "path": "tests/news/test_news_scheduler.py",
          "from": "test_enqueue_is_idempotent_and_lease_is_exclusive",
          "through": "test_scheduler_lifecycle_survives_restart_without_duplicate_terminal_work"
        }
      ]
    }
